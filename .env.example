# 复制为 .env 后按需修改；docker compose 与各服务共用这一组约定
SPRING_PROFILES_ACTIVE=dev

# 基础设施地址
NACOS_ADDR=127.0.0.1:8848
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123
SENTINEL_DASHBOARD=127.0.0.1:8090
SEATA_ADDR=127.0.0.1:8091

# Nacos 3.x 默认开启鉴权
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# 业务配置：JWT 使用 HS256 共享密钥，长度必须 >= 32 字节；生产环境请替换为随机值
BLUECRYSTAL_JWT_SECRET=bluecrystal-mall-dev-secret-change-me-32bytes
BLUECRYSTAL_JWT_TTL=30m
